<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Login - SupportHub</title>
</head>

<body>

    <h1>Login</h1>

    <form action="/login" method="POST">

        <label>Email:</label>
        <input 
            type="email" 
            name="email"
            required
        >

        <br><br>

        <label>Senha:</label>
        <input 
            type="password" 
            name="senha"
            required
        >

        <br><br>

        <button type="submit">
            Entrar
        </button>

    </form>

</body>

</html>