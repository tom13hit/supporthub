<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro - SupportHub</title>
</head>

<body>

    <h1>Criar conta</h1>

    <form action="/cadastro" method="POST">

        <label>Nome</label>
        <input type="text" name="nome">

        <br><br>

        <label>Email</label>
        <input type="email" name="email">

        <br><br>

        <label>Senha</label>
        <input type="password" name="senha">

        <br><br>

        <button type="submit">
            Criar conta
        </button>

    </form>

</body>
</html>