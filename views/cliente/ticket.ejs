<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Abrir Chamado - SupportHub</title>
</head>

<body>

    <h1>Abrir Chamado</h1>

    <p>Olá, <%= usuario.nome %>!</p>

    <form action="/ticket" method="POST">

        <label>Título</label><br>
        <input
            type="text"
            name="titulo"
            required
        >

        <br><br>

        <label>Descrição</label><br>
        <textarea
            name="descricao"
            rows="6"
            required
        ></textarea>

        <br><br>

        <label>Prioridade</label><br>

        <select name="prioridade">

            <option value="baixa">Baixa</option>
            <option value="media">Média</option>
            <option value="alta">Alta</option>

        </select>

        <br><br>

        <button type="submit">
            Abrir Chamado
        </button>

    </form>

</body>

</html>